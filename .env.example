# Plantilla de variables. Copiala a .env y completa los valores.

NODE_ENV=development
PORT=3020

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# El contenedor atmosfera-postgres publica el 5432 en el host, asi que desde la
# Mac se llega por localhost. Cuando el API corra dentro de Docker en la red del
# Postgres, el host pasa a ser el nombre del contenedor:
#   postgresql://iris_app:...@atmosfera-postgres:5432/iris?schema=iris
#
# El rol iris_app solo puede crear objetos en el esquema 'iris', nunca en
# 'public', de ahi el ?schema=iris. La clave esta en atmosfera-postgres/.env
# (IRIS_APP_PASSWORD).
DATABASE_URL="postgresql://iris_app:PASSWORD@localhost:5432/iris?schema=iris"

# Base desechable que Prisma usa para validar migraciones en 'migrate dev'.
SHADOW_DATABASE_URL="postgresql://iris_app:PASSWORD@localhost:5432/iris_shadow?schema=iris"

# ---------------------------------------------------------------------------
# Autenticacion (docs/plans/01-login/README.md)
# ---------------------------------------------------------------------------
# Genera cada uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=
REFRESH_TOKEN_SECRET=
# 15 minutos. Es lo que viaja en cada peticion.
ACCESS_TOKEN_TTL_SECONDS=900
# Una sesion que no se usa en este tiempo caduca y pide la contrasena otra vez.
REFRESH_TOKEN_IDLE_DAYS=60

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Las consolas nativas no usan CORS; esto solo afecta a navegadores.
CORS_ORIGIN=http://localhost:3000

# Raiz de la web. Los enlaces de los correos (aceptar invitacion) apuntan aqui:
# <WEB_URL>/invitacion?token=...
WEB_URL=http://localhost:3000

# Freno general de la API, por IP.
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# Intentos de login por IP.
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5

# Otros frenos por IP (opcionales; estos son los valores por defecto del
# contrato). Las pruebas e2e los suben en test/setup.ts.
# SIGN_UP_THROTTLE_LIMIT=5          # cuentas nuevas por hora
# FORGOT_THROTTLE_LIMIT=3           # pedidos de codigo por hora
# RESET_CODE_THROTTLE_LIMIT=10      # verificar/restablecer cada 15 min
# INVITATION_THROTTLE_LIMIT=10      # aceptar invitaciones cada 15 min

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
# Sin estas dos, en desarrollo los correos se escriben en el log. En produccion
# son obligatorias: el API no arranca sin ellas.
RESEND_API_KEY=
MAIL_FROM="Iris <no-reply@tudominio.com>"

# ---------------------------------------------------------------------------
# Almacenamiento de multimedia (S3 compatible)
# ---------------------------------------------------------------------------
# En local es MinIO: docker compose -f docker-compose.dev.yml up -d
# (API S3 en :9000, consola en :9001). En produccion, Cloudflare R2.
# Sin estas variables, en desarrollo el API arranca igual y las subidas
# responden 503; en produccion son obligatorias.
STORAGE_ENDPOINT=http://localhost:9000
# MinIO firma con us-east-1; R2 usa "auto".
STORAGE_REGION=us-east-1
# Las mismas que MINIO_ROOT_USER / MINIO_ROOT_PASSWORD de docker-compose.dev.yml.
STORAGE_ACCESS_KEY_ID=iris-dev
STORAGE_SECRET_ACCESS_KEY=iris-dev-secret
STORAGE_BUCKET=iris-media
# true para MinIO (rutas host/bucket/clave).
STORAGE_FORCE_PATH_STYLE=true
# Host con el que se firman las URLs para los clientes. Vacio = STORAGE_ENDPOINT.
# Al probar con la PC de Windows, pon la IP de la Mac: http://192.168.x.x:9000
STORAGE_PUBLIC_ENDPOINT=

# ---------------------------------------------------------------------------
# Datos de ejemplo (pnpm db:seed:dev)
# ---------------------------------------------------------------------------
# Contrasena de las cuentas de ejemplo. Por defecto: vidanueva123.
# DEV_SEED_PASSWORD=
